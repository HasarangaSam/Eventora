generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  VALID
  CANCELLED
  CHECKED_IN
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String?
  role            Role     @default(ATTENDEE)
  emailVerified   Boolean  @default(false)
  isActive        Boolean  @default(true)
  googleId        String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens        RefreshToken[]
  refreshTokenFamilies RefreshTokenFamily[]
  emailVerifications   EmailVerification[]
  passwordResetTokens  PasswordResetToken[]
  events               Event[]
  registrations        Registration[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model RefreshTokenFamily {
  id        String   @id @default(uuid())
  userId    String
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  family RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([name])
}

model Event {
  id          String          @id @default(uuid())
  organizerId String
  categoryId  String
  title       String
  slug        String          @unique
  description String
  venue       String
  address     String?
  coverImage  String?
  status      EventStatus     @default(DRAFT)
  visibility  EventVisibility @default(PUBLIC)
  capacity    Int
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organizer     User           @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sessions      EventSession[]
  ticketTypes   TicketType[]
  registrations Registration[]
  tickets       Ticket[]

  @@index([organizerId])
  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@index([startsAt])
  @@index([createdAt])
}

model EventSession {
  id        String   @id @default(uuid())
  eventId   String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([startsAt])
}

model TicketType {
  id           String   @id @default(uuid())
  eventId      String
  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  quantity     Int
  soldQuantity Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  tickets       Ticket[]

  @@index([eventId])
  @@index([createdAt])
}

model Registration {
  id           String             @id @default(uuid())
  userId       String
  eventId      String
  ticketTypeId String
  quantity     Int
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now())
  cancelledAt  DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@index([ticketTypeId])
  @@index([status])
}

model Ticket {
  id             String       @id @default(uuid())
  registrationId String
  eventId        String
  ticketTypeId   String
  ticketNumber   String       @unique
  qrToken        String       @unique
  status         TicketStatus @default(VALID)
  createdAt      DateTime     @default(now())
  checkedInAt    DateTime?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@index([status])
}
