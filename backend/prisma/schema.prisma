generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
}

enum PaymentProvider {
  PAYHERE
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOIDED
}

enum CheckInMethod {
  QR_SCAN
  MANUAL_REFERENCE
}

enum EmailType {
  PURCHASE_CONFIRMATION
  ORGANIZER_APPLICATION_DECISION
  EVENT_CANCELLATION
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id          String     @id @default(cuid())
  clerkUserId String     @unique @db.VarChar(255)
  email       String     @db.VarChar(320)
  firstName   String?    @db.VarChar(100)
  lastName    String?    @db.VarChar(100)
  imageUrl    String?    @db.Text
  role        UserRole   @default(ATTENDEE)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  organizerApplications OrganizerApplication[] @relation("ApplicationApplicant")
  reviewedApplications  OrganizerApplication[] @relation("ApplicationReviewer")
  events                Event[]
  cancelledEvents       Event[]                @relation("EventCanceller")
  registrations         Registration[]
  checkIns              CheckIn[]

  @@index([email])
  @@index([role, status])
}

model OrganizerApplication {
  id               String                     @id @default(cuid())
  applicantId      String
  status           OrganizerApplicationStatus @default(PENDING)
  organizationName String                     @db.VarChar(200)
  description      String                     @db.Text
  submittedAt      DateTime                   @default(now()) @db.Timestamptz(6)
  reviewedAt       DateTime?                  @db.Timestamptz(6)
  reviewerId       String?
  decisionNote     String?                    @db.Text
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)

  applicant       User            @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewer        User?           @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  emailDeliveries EmailDelivery[]

  @@index([applicantId, status])
  @@index([status, submittedAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  events Event[]
}

model Event {
  id                 String      @id @default(cuid())
  organizerId        String
  categoryId         String
  title              String      @db.VarChar(200)
  slug               String      @unique @db.VarChar(240)
  description        String      @db.Text
  venue              String      @db.VarChar(200)
  city               String      @db.VarChar(120)
  startAt            DateTime    @db.Timestamptz(6)
  endAt              DateTime    @db.Timestamptz(6)
  timezone           String      @db.VarChar(64)
  capacity           Int?
  // Updated atomically with ticket-type counters during reservation transactions.
  ticketsReserved    Int         @default(0)
  ticketsSold        Int         @default(0)
  coverImageUrl      String?     @db.Text
  coverImagePublicId String?     @unique @db.VarChar(255)
  status             EventStatus @default(DRAFT)
  isFeatured         Boolean     @default(false)
  publishedAt        DateTime?   @db.Timestamptz(6)
  cancelledAt        DateTime?   @db.Timestamptz(6)
  cancelledById      String?
  cancellationReason String?     @db.Text
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)

  organizer       User                   @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  cancelledBy     User?                  @relation("EventCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sessions        EventSession[]
  ticketTypes     TicketType[]
  registrations   Registration[]
  reservations    InventoryReservation[]
  tickets         Ticket[]
  checkIns        CheckIn[]
  emailDeliveries EmailDelivery[]

  @@index([status, startAt])
  @@index([categoryId, status, startAt])
  @@index([organizerId, status, startAt])
  @@index([isFeatured, status, startAt])
}

model EventSession {
  id          String   @id @default(cuid())
  eventId     String
  title       String   @db.VarChar(200)
  description String?  @db.Text
  speaker     String?  @db.VarChar(200)
  venue       String?  @db.VarChar(200)
  startAt     DateTime @db.Timestamptz(6)
  endAt       DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, startAt])
}

model TicketType {
  id               String    @id @default(cuid())
  eventId          String
  name             String    @db.VarChar(120)
  description      String?   @db.Text
  price            Decimal   @db.Decimal(12, 2)
  currency         String    @db.Char(3)
  quantity         Int
  // Atomic counters allow conditional reservation updates without read-then-write races.
  quantityReserved Int       @default(0)
  quantitySold     Int       @default(0)
  salesStartAt     DateTime? @db.Timestamptz(6)
  salesEndAt       DateTime? @db.Timestamptz(6)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registrations Registration[]
  reservations  InventoryReservation[]
  tickets       Ticket[]

  @@unique([eventId, name])
  @@index([eventId, isActive, salesStartAt, salesEndAt])
}

model Registration {
  id             String             @id @default(cuid())
  userId         String
  eventId        String
  ticketTypeId   String
  quantity       Int
  unitPrice      Decimal            @db.Decimal(12, 2)
  totalAmount    Decimal            @db.Decimal(12, 2)
  currency       String             @db.Char(3)
  status         RegistrationStatus @default(PENDING)
  idempotencyKey String?            @db.VarChar(128)
  confirmedAt    DateTime?          @db.Timestamptz(6)
  expiredAt      DateTime?          @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)

  attendee        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event           Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType      TicketType            @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  reservation     InventoryReservation?
  payments        PaymentAttempt[]
  tickets         Ticket[]
  exceptions      PaymentException[]
  emailDeliveries EmailDelivery[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([ticketTypeId, status])
}

model InventoryReservation {
  id             String            @id @default(cuid())
  registrationId String            @unique
  eventId        String
  ticketTypeId   String
  quantity       Int
  status         ReservationStatus @default(HELD)
  // A database-clock default and CHECK constraint enforce the exact ten-minute hold window.
  expiresAt      DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP + interval '10 minutes')")) @db.Timestamptz(6)
  committedAt    DateTime?         @db.Timestamptz(6)
  releasedAt     DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([eventId, status, expiresAt])
  @@index([ticketTypeId, status, expiresAt])
}

model PaymentAttempt {
  id                String          @id @default(cuid())
  registrationId    String
  provider          PaymentProvider @default(PAYHERE)
  merchantReference String          @unique @db.VarChar(100)
  providerPaymentId String?         @unique @db.VarChar(100)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  status            PaymentStatus   @default(INITIATED)
  providerStatus    String?         @db.VarChar(80)
  paidAt            DateTime?       @db.Timestamptz(6)
  verifiedAt        DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  registration Registration       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  exceptions   PaymentException[]

  @@index([registrationId, createdAt])
  @@index([status, createdAt])
}

model PaymentException {
  id               String   @id @default(cuid())
  registrationId   String
  paymentAttemptId String?
  reasonCode       String   @db.VarChar(80)
  description      String   @db.Text
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  registration   Registration    @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([registrationId, createdAt])
  @@index([paymentAttemptId, createdAt])
}

model Ticket {
  id             String       @id @default(cuid())
  registrationId String
  eventId        String
  ticketTypeId   String
  reference      String       @unique @db.VarChar(32)
  qrTokenHash    String       @unique @db.VarChar(64)
  status         TicketStatus @default(ISSUED)
  issuedAt       DateTime     @default(now()) @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  checkIn      CheckIn?

  @@index([registrationId, createdAt])
  @@index([eventId, status])
}

model CheckIn {
  id            String        @id @default(cuid())
  ticketId      String        @unique
  eventId       String
  checkedInById String
  method        CheckInMethod
  checkedInAt   DateTime      @default(now()) @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  checkedInBy User   @relation(fields: [checkedInById], references: [id], onDelete: Restrict)

  @@index([eventId, checkedInAt])
  @@index([checkedInById, checkedInAt])
}

model EmailDelivery {
  id                     String              @id @default(cuid())
  type                   EmailType
  status                 EmailDeliveryStatus @default(PENDING)
  idempotencyKey         String              @unique @db.VarChar(160)
  recipient              String              @db.VarChar(320)
  registrationId         String?
  organizerApplicationId String?
  eventId                String?
  attemptCount           Int                 @default(0)
  nextAttemptAt          DateTime?           @db.Timestamptz(6)
  sentAt                 DateTime?           @db.Timestamptz(6)
  lastError              String?             @db.VarChar(500)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)

  registration         Registration?         @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  organizerApplication OrganizerApplication? @relation(fields: [organizerApplicationId], references: [id], onDelete: SetNull)
  event                Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([type, createdAt])
}
